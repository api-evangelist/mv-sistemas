          "id": "621a52c4-f706-47f3-82f6-f40301c63503",
          "name": "PostGerarToken",
          "request": {
            "name": "PostGerarToken",
            "description": {
              "content": "Gera um **código de validação temporário** (token alfanumérico de **6 caracteres**) para o beneficiário e, opcionalmente, para um prestador vinculado — usado em fluxos que exigem confirmação rápida (ex.: chat, autosserviço).\n\nO token costuma ter **validade curta** (da ordem de **minutos**). Se o beneficiário não for encontrado para os dados informados, a API pode responder com **400** ou **404**, conforme o contrato técnico.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "Funcoes",
                "PostGerarToken"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nrCarteira\": \"<string>\",\n  \"cdPrestador\": \"\"\n}",
              "options": {
