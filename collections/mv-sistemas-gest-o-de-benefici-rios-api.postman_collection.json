                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroDocumento\": \"<string>\",\n  \"numeroCarteira\": \"<string>\",\n  \"nomeCarteira\": \"<string>\",\n  \"numeroCartaoNacionalDeSaude\": \"<string>\",\n  \"nome\": \"<string>\",\n  \"nomeSocial\": \"<string>\",\n  \"dataNascimento\": \"<string>\",\n  \"sexo\": \"<string>\",\n  \"email\": \"<string>\",\n  \"telefone\": \"<string>\",\n  \"nomeMae\": \"<string>\",\n  \"nomePai\": \"<string>\",\n  \"enderecoCEP\": \"<string>\",\n  \"enderecoNumero\": \"<string>\",\n  \"enderecoComplemento\": \"<string>\",\n  \"enderecoLogradouro\": \"<string>\",\n  \"enderecoBairro\": \"<string>\",\n  \"enderecoCidade\": \"<string>\",\n  \"enderecoUF\": \"<string>\",\n  \"codigoAns\": \"<string>\",\n  \"codigoOperadora\": \"<string>\",\n  \"codigoMatricula\": \"<string>\",\n  \"produto\": \"<string>\",\n  \"codigoPlanoAns\": \"<string>\",\n  \"descricaoPlanoAns\": \"<string>\",\n  \"codigoEmpresa\": \"<string>\",\n  \"codigoPlanoPaciente\": \"<string>\",\n  \"codigoConvenio\": \"<string>\",\n  \"codigoPlanoConvenio\": \"<string>\",\n  \"codigoSubPlano\": \"<string>\",\n  \"status\": \"<string>\"\n}",
