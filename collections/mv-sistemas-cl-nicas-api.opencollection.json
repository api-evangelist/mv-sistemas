{
  "opencollection": "1.0.0",
  "info": {
    "name": "Clinic Agenda Agendamento Clínicas API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Clínicas",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Consultar clínicas.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.globalhealth.mv/available-appointments/api/v1/clinics",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "ID do Clinic"
              },
              {
                "name": "externalId",
                "value": "",
                "type": "query",
                "description": "ID externo"
              },
              {
                "name": "subscriptionId",
                "value": "",
                "type": "query",
                "description": "ID da conta Clinic Connect."
              }
            ]
          },
          "docs": "Endpoint utilizado para consultar clínicas com base em filtros personalizados, possibilitando localizar unidades de acordo com os critérios desejados."
        },
        {
          "info": {
            "name": "Criar ou alterar dados da clínica.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.globalhealth.mv/available-appointments/api/v1/clinics",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Endpoint responsável por inserir ou atualizar os dados de uma clínica no sistema, garantindo que as informações cadastrais estejam sempre atualizadas."
        }
      ]
    }
  ],
  "bundled": true
}