          "name": "Criar agendamento a partir de um Agendamento de performance",
          "request": {
            "name": "Criar agendamento a partir de um Agendamento de performance",
            "description": {
              "content": "Cria um agendamento (Schedules) vinculado a um Agendamento de performance disponível.\nÉ obrigatório informar `id` ou `externalId` do Agendamento de performance, além de patient, insurance e termCbo.\nO slot deve estar disponível (não ocupado).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "performance-schedules",
                "scheduling"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"<long>\",\n  \"externalId\": \"<string>\",\n  \"insurance\": {\n    \"ansCode\": \"<string>\",\n    \"number\": \"<string>\",\n    \"expirationDate\": \"<string>\",\n    \"newborn\": \"<boolean>\"\n  },\n  \"patient\": {\n    \"id\": \"<long>\",\n    \"externalId\": \"<string>\",\n    \"name\": \"<string>\",\n    \"socialName\": \"<string>\",\n    \"birthDate\": \"<string>\",\n    \"cellphone\": \"<string>\",\n    \"email\": \"<string>\",\n    \"identificationType\": \"<string>\",\n    \"identificationNumber\": \"<string>\",\n    \"gender\": \"<string>\",\n    \"mother\": \"<string>\",\n    \"observation\": \"<string>\",\n    \"address\": \"<string>\",\n    \"state\": \"<string>\",\n    \"city\": \"<string>\",\n    \"district\": \"<string>\",\n    \"zipCode\": \"<string>\",\n    \"addressComplement\": \"<string>\",\n    \"addressNumber\": \"<string>\"\n  },\n  \"termCbo\": \"<string>\",\n  \"observation\": \"<string>\"\n}",
