{
  "opencollection": "1.0.0",
  "info": {
    "name": "Clinic Agenda Agendamento Importação de Dados API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Importação de Dados",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Importar dados do paciente (fluxo síncrono)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.globalhealth.mv/available-appointments/api/importations/v1/patient-data",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Importa dados do paciente no clinic-service (sync flow). Retorna ID do paciente e mensagem amigável.\nEm caso de erro, nunca expõe stack trace; a mensagem amigável é retornada no corpo da resposta.\n"
        }
      ]
    }
  ],
  "bundled": true
}