{
  "opencollection": "1.0.0",
  "info": {
    "name": "Clinic Agenda Agendamento Movimentações de Visitantes API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Movimentações de Visitantes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "createVisitorMovement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.globalhealth.mv/available-appointments/api/api/v1/entry-control-protocols/:id/visitor-movements",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "exitMovement",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.globalhealth.mv/available-appointments/api/api/v1/entry-control-protocols/:id/visitor-movements/:visitorMovementId/exit",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "visitorMovementId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}