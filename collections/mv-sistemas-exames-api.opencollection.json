{
  "opencollection": "1.0.0",
  "info": {
    "name": "Clinic Agenda Agendamento Exames API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Exames",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Buscar exames (TUSS)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.globalhealth.mv/available-appointments/api/v1/exams",
            "params": [
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Termo para filtrar exames (código, descrição ou termo)"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Página atual da listagem"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Quantidade de registros por página"
              }
            ]
          },
          "docs": "Retorna uma lista paginada de procedimentos TUSS, com filtro opcional por termo de busca."
        }
      ]
    }
  ],
  "bundled": true
}