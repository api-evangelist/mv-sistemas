{
  "opencollection": "1.0.0",
  "info": {
    "name": "Clinic Agenda Agendamento Attendance API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Attendance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Buscar atendimentos",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.globalhealth.mv/available-appointments/api/v1/attendance",
            "params": [
              {
                "name": "documentId",
                "value": "",
                "type": "query",
                "description": "Documento do paciente (ex: CPF)"
              },
              {
                "name": "login",
                "value": "",
                "type": "query",
                "description": "Login do paciente"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Status do atendimento"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Número da página (zero-based)"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Quantidade de registros por página"
              }
            ]
          },
          "docs": "Busca uma lista de atendimentos utilizando as opções de filtros disponíveis"
        }
      ]
    }
  ],
  "bundled": true
}